{
  "name": "gazna-qonunchilik",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Учебный справочник по законодательству для сотрудника Комитета казначейской службы",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fetch-sources": "node scripts/fetch-sources.mjs",
    "acts-table": "node scripts/acts-table.mjs",
    "parse": "node scripts/parse-sources.mjs",
    "dev": "node scripts/build-data.mjs && next dev",
    "data": "node scripts/build-glossary.mjs && node scripts/build-data.mjs",
    "build": "node scripts/build-data.mjs && next build && node scripts/build-sw.mjs",
    "start": "npx serve out",
    "update-sources": "node scripts/update-sources.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "node-html-parser": "^6.1.13",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
